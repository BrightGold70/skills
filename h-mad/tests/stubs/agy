#!/usr/bin/env bash
# agy (Antigravity CLI) stub for hmad-dispatch `exec` tests. Records argv, prints
# the canned response to stdout (agy --print puts ONLY the response there), and
# exits with a controllable code. The prompt is the LAST positional arg.
printf 'agy %s\n' "$*" >> "${HMAD_STUB_CAPTURE:-/dev/null}"

# Capture the prompt (last arg) if asked.
if [ -n "${HMAD_STUB_AGY_PROMPT_CAPTURE:-}" ]; then
  printf '%s' "${!#}" > "$HMAD_STUB_AGY_PROMPT_CAPTURE"
fi

# Simulate a long-running task so the wrapper's --timeout watchdog can fire.
[ -n "${HMAD_STUB_AGY_SLEEP:-}" ] && sleep "$HMAD_STUB_AGY_SLEEP"

# The response (agy --print writes it straight to stdout). `${VAR-default}`
# allows an explicitly empty response while retaining the old default.
if [ -n "${HMAD_STUB_AGY_RESP+x}" ]; then
  [ -n "$HMAD_STUB_AGY_RESP" ] && printf '%s\n' "$HMAD_STUB_AGY_RESP"
else
  printf '%s\n' 'VERDICT: COMPLIANT'
fi
# Test-only escape hatch: populate the wrapper's redirected transcript without
# making the agent response non-empty. Existing knobs and behavior are unchanged.
if [ -n "${HMAD_STUB_AGY_TRANSCRIPT_PATH:-}" ]; then
  printf '%s\n' "${HMAD_STUB_AGY_TRANSCRIPT:-}" >> "$HMAD_STUB_AGY_TRANSCRIPT_PATH"
fi

# J29: simulate a CONCURRENT dispatch landing its own verdict in a shared --out
# while this one is still running. Writing from inside the stub is what puts the
# rival's content there in the only window that matters -- after the wrapper
# snapshotted the file and before it writes its own answer.
if [ -n "${HMAD_STUB_AGY_RIVAL_OUT:-}" ]; then
  printf '%s\n' "${HMAD_STUB_AGY_RIVAL:-}" > "$HMAD_STUB_AGY_RIVAL_OUT"
fi
exit "${HMAD_STUB_AGY_RC:-0}"
