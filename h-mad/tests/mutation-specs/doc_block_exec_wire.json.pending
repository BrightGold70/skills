{
  "_why": "Task 5 wiring mutations: the consumer must delegate gate extraction, selection, substitution, and execution through the public helper module.",
  "root": "../..",
  "command": ["python3.11", "-m", "pytest", "tests/test_h_mad_collect_report_docs.py", "-q"],
  "target_command": ["python3.11", "-m", "pytest", "-q"],
  "mutations": [
    {
      "name": "wire-revert-extract",
      "_mechanism": "Restore local, tag-tolerant gate extraction.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    return dbe.select(dbe.extract(SKILL_MD, \"## Second surface — the codex leg\"))",
      "replace": "    _bodies = re.findall(r\"```bash[^\\n]*\\n(.*?)```\", _second_surface(), re.S)\n    _gating = [b for b in _bodies if \"h_mad_audit_gate.py\" in b]\n    assert _gating, \"Second surface must contain a bash block that runs the gate\"\n    assert len(_gating) == 1, f\"expected exactly one gating bash block, got {len(_gating)}\"\n    return dbe.Block(text=_gating[0], shell=\"strict\", lineno=0, info=\"hmad:exec\")",
      "test": "tests/test_h_mad_collect_report_docs.py::test_gate_block_resolves_through_doc_block_exec"
    },
    {
      "name": "wire-revert-select",
      "_mechanism": "Restore local cardinality selection after helper extraction.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    return dbe.select(dbe.extract(SKILL_MD, \"## Second surface — the codex leg\"))",
      "replace": "    _blocks = dbe.extract(SKILL_MD, \"## Second surface — the codex leg\")\n    if not _blocks:\n        raise dbe.BlockNotFound()\n    if len(_blocks) > 1:\n        raise dbe.AmbiguousBlock(len(_blocks))\n    return _blocks[0]",
      "test": "tests/test_h_mad_collect_report_docs.py::test_gate_block_resolves_through_doc_block_exec"
    },
    {
      "name": "wire-revert-run",
      "_mechanism": "Restore inline bash execution instead of dbe.run_block.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    return dbe.run_block(subbed, preamble=preamble, timeout=60.0)",
      "replace": "    import subprocess\n    p = subprocess.run(\n        [\"bash\", \"-c\", preamble + subbed.text],\n        capture_output=True, text=True, timeout=60.0,\n    )\n    return dbe.RunResult(rc=p.returncode, stdout=p.stdout, stderr=p.stderr, shell=subbed.shell)",
      "test": "tests/test_h_mad_collect_report_docs.py::test_recipe_runs_through_run_block"
    },
    {
      "name": "wire-revert-substitute",
      "_mechanism": "Restore a local path replacement instead of dbe.substitute.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    subbed, _ = dbe.substitute(\n        block, {\"~/.claude/skills/h-mad/scripts/h_mad_audit_gate.py\": shlex.quote(str(gate))}\n    )",
      "replace": "    subbed = dbe.Block(\n        text=block.text.replace(\n            \"~/.claude/skills/h-mad/scripts/h_mad_audit_gate.py\", shlex.quote(str(gate))\n        ),\n        shell=block.shell,\n        lineno=block.lineno,\n        info=block.info,\n    )",
      "test": "tests/test_h_mad_collect_report_docs.py::test_recipe_runs_through_run_block"
    },
    {
      "name": "wire-unconditional",
      "_mechanism": "Fall back to an untagged local gate block when helper extraction returns no tag.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    return dbe.select(dbe.extract(SKILL_MD, \"## Second surface — the codex leg\"))",
      "replace": "    _blocks = dbe.extract(SKILL_MD, \"## Second surface — the codex leg\")\n    if _blocks:\n        return dbe.select(_blocks)\n    _bodies = re.findall(r\"```bash[^\\n]*\\n(.*?)```\", _second_surface(), re.S)\n    _gating = [b for b in _bodies if \"h_mad_audit_gate.py\" in b]\n    assert _gating\n    assert len(_gating) == 1\n    return dbe.Block(text=_gating[0], shell=\"strict\", lineno=0, info=\"hmad:exec\")",
      "test": "tests/test_h_mad_collect_report_docs.py::test_gate_block_refuses_an_untagged_recipe"
    },
    {
      "name": "hand-rolled-extraction-widened",
      "_mechanism": "Add a local regex fallback on the executing consumer path.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "def _gate_bash_block() -> str:\n    return _gate_block().text",
      "replace": "def _gate_bash_block() -> str:\n    try:\n        return _gate_block().text\n    except dbe.DocBlockError:\n        _bodies = re.findall(r\"```bash[^\\n]*\\n(.*?)```\", _second_surface(), re.S)\n        return [b for b in _bodies if \"h_mad_audit_gate.py\" in b][0]",
      "test": "tests/test_h_mad_collect_report_docs.py::test_only_the_exec_scan_hand_rolls_extraction"
    },
    {
      "name": "exec-scan-executes",
      "_mechanism": "Make the documentation scan execute its selected exec-codex block.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "    assert exec_block, \"Second surface must dispatch the codex leg via exec\"",
      "replace": "    assert exec_block, \"Second surface must dispatch the codex leg via exec\"\n    dbe.run_block(\n        dbe.Block(text=exec_block, shell=\"plain\", lineno=0, info=\"\"), timeout=1.0\n    )",
      "test": "tests/test_h_mad_collect_report_docs.py::test_exec_block_scan_performs_no_execution"
    },
    {
      "name": "consumer-from-import",
      "_mechanism": "Bypass the module alias with a direct helper import.",
      "file": "tests/test_h_mad_collect_report_docs.py",
      "find": "def _gate_block() -> dbe.Block:\n    return dbe.select(dbe.extract(SKILL_MD, \"## Second surface — the codex leg\"))\n\n\ndef _gate_bash_block() -> str:\n    return _gate_block().text\n\n\ndef _run_recipe(*, phase: str, cycle: int, report: Path, root: Path) -> dbe.RunResult:\n    collector = SCRIPT_DIR / \"h_mad_collect_report.py\"\n    gate = SCRIPT_DIR / \"h_mad_audit_gate.py\"\n    block = _gate_block()\n    # the doc addresses the installed skill; point the snippet at this tree\n    subbed, _ = dbe.substitute(\n        block, {\"~/.claude/skills/h-mad/scripts/h_mad_audit_gate.py\": shlex.quote(str(gate))}\n    )\n    q = shlex.quote\n    preamble = (\n        f'COLLECT_OUT=$({q(sys.executable)} {q(str(collector))} --surface codex '\n        f'--feature f --phase {phase} --cycle {cycle} '\n        f'--report {q(str(report))} --project-root {q(str(root))})\\n'\n    )\n    return dbe.run_block(subbed, preamble=preamble, timeout=60.0)",
      "replace": "from h_mad_doc_block_exec import extract, select, run_block, substitute  # noqa: E402\n\ndef _gate_block() -> dbe.Block:\n    return select(extract(SKILL_MD, \"## Second surface — the codex leg\"))\n\n\ndef _gate_bash_block() -> str:\n    return _gate_block().text\n\n\ndef _run_recipe(*, phase: str, cycle: int, report: Path, root: Path) -> dbe.RunResult:\n    collector = SCRIPT_DIR / \"h_mad_collect_report.py\"\n    gate = SCRIPT_DIR / \"h_mad_audit_gate.py\"\n    block = _gate_block()\n    # the doc addresses the installed skill; point the snippet at this tree\n    subbed, _ = substitute(\n        block, {\"~/.claude/skills/h-mad/scripts/h_mad_audit_gate.py\": shlex.quote(str(gate))}\n    )\n    q = shlex.quote\n    preamble = (\n        f'COLLECT_OUT=$({q(sys.executable)} {q(str(collector))} --surface codex '\n        f'--feature f --phase {phase} --cycle {cycle} '\n        f'--report {q(str(report))} --project-root {q(str(root))})\\n'\n    )\n    return run_block(subbed, preamble=preamble, timeout=60.0)",
      "test": "tests/test_h_mad_collect_report_docs.py::test_consumer_calls_the_helper_module_qualified"
    }
  ]
}
