) _need_val gate-wait --interval $# || return $?; interval=\"$2\"; shift 2 ;;"},{"line_number":1527,"content":"  # `--out` is what a waiter polls for, so it must never be observable"},{"line_number":1534,"content":"  # mktemp, not \"$$\": a single wrapper invocation can write --out more than"},{"line_number":1546,"content":"_cmd_report_wait() {  # <report-path> [--timeout <s>] [--interval <s>]"},{"line_number":1558,"content":"  # `exec --out` case, copied into place once the agent has finished. Opt-in:"},{"line_number":1560,"content":"  # else, and it is sound here only because `exec` now writes `--out`"},{"line_number":1982,"content":"# THE FIX. agy grows `--output-format stream-json`, which emits one NDJSON event"},{"line_number":1992,"content":"# response text, `--out` is the response text, `$?` is still \"did the CLI run\"."},{"line_number":1999,"content":"# last-writer hazard J29 records for --out, arriving here by a different route."},{"line_number":2237,"content":"  # deterministically `STATUS: NEEDS_CONTEXT` -- and the caller wrote it to --out,"},{"line_number":2335,"content":"_cmd_ask() {  # <agent> <promptfile> [--timeout <s>] [--out <file>]"},{"line_number":2338,"content":"  # buffer. The orchestration path is `dispatch`+`await`; the report-file path is"},{"line_number":2351,"content":"    --timeout) _need_val ask --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"},{"line_number":2352,"content":"    --out) _need_val ask --out $# || return $?; out=\"$2\"; shift 2 ;;"},{"line_number":2361,"content":"  local wargs=(\"$agent\"); [ -n \"$timeout\" ] && wargs+=(--timeout \"$timeout\")"},{"line_number":2371,"content":"_cmd_probe() {  # <agent> [--timeout <s>]"},{"line_number":2384,"content":"    --timeout) _need_val probe --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"},{"line_number":2388,"content":"    ''|*[!0-9]*|0) echo \"hmad-dispatch: probe: --timeout must be a positive integer; nothing was sent.\" >&2; return 2 ;;"},{"line_number":2724,"content":"# Does a recovered agy response carry a verdict line worth promoting to --out?"},{"line_number":2745,"content":"# J29: `--out` is last-writer-wins across concurrent dispatches, silently. Two"},{"line_number":2747,"content":"# responder's answer, so a caller who reads `--out` loses a verdict with nothing"},{"line_number":2760,"content":"# Refuse to overwrite an `--out` whose content changed since this dispatch"},{"line_number":2766,"content":"# and SKILL.md's --out paths are templated per feature+module, so a legitimate"},{"line_number":2779,"content":"  echo \"hmad-dispatch: exec: REFUSING to overwrite --out $f — its content changed while this dispatch ran (another dispatch wrote there; J29). Existing file preserved; this dispatch's answer is on stdout and in the transcript.\" >&2"},{"line_number":2783,"content":"# Called as `write || _out_write_failed <file>` at every exec --out write site."},{"line_number":2785,"content":"# dispatch (rc=1, empty stdout), so an unwritable --out -- a typo'd directory --"},{"line_number":2789,"content":"  echo \"hmad-dispatch: exec: cannot write --out $1 (J56). This dispatch's answer is on stdout and in the transcript.\" >&2"},{"line_number":2944,"content":"  # --output-last-message file, and exactly one transcript line —"},{"line_number":2969,"content":"_cmd_exec() {  # <codex|agy|grok> <promptfile> [--cd <dir>] [--model <m>] [--effort <e>] [--out <file>] [--log <file>] [--timeout <s>] [codex: --sandbox <mode>] [agy: --sandbox] [grok: --sandbox <profile>]"},{"line_number":2978,"content":"  #   codex — `codex exec`, prompt via stdin, final message via --output-last-message."},{"line_number":3066,"content":"    --out) _need_val exec --out $# || return $?; out=\"$2\"; shift 2 ;;"},{"line_number":3068,"content":"    --timeout) _need_val exec --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"}]}]},"locations":[]}
