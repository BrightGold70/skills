05,97,32,45,45,111,117,116,112,117,116,45,108,97,115,116,45,109,101,115,115,97,103,101,46,10,51,48,54,54,58,32,32,32,32,45,45,111,117,116,41,32,95,110,101,101,100,95,118,97,108,32,101,120,101,99,32,45,45,111,117,116,32,36,35,32,124,124,32,114,101,116,117,114,110,32,36,63,59,32,111,117,116,61,34,36,50,34,59,32,115,104,105,102,116,32,50,32,59,59,10,51,48,54,56,58,32,32,32,32,45,45,116,105,109,101,111,117,116,41,32,95,110,101,101,100,95,118,97,108,32,101,120,101,99,32,45,45,116,105,109,101,111,117,116,32,36,35,32,124,124,32,114,101,116,117,114,110,32,36,63,59,32,116,105,109,101,111,117,116,61,34,36,50,34,59,32,115,104,105,102,116,32,50,32,59,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],"stderr":[],"exit_code":0,"match_count":40,"file_matches":[{"path":"/Users/kimhawk/.local/state/h-mad/grok-audit-surface/run-ab2c85dc2e25-20261024T132452Z/roots/gas-root-d1-s2v1-z7v41lbh/h-mad/scripts/hmad-dispatch.sh","matches":[{"line_number":374,"content":"  raw=\"$(_cmd_run --timeout \"${HMAD_TAIL_READ_TIMEOUT:-2}\" -- \\"},{"line_number":1189,"content":"  # report-file completion are for -- never the launch response."},{"line_number":1304,"content":"_cmd_await() {  # $1 task_id, [--timeout <s>]"},{"line_number":1309,"content":"  while [ $# -gt 0 ]; do case \"$1\" in --timeout) _need_val await --timeout $# || return $?; timeout=\"$2\"; shift 2 ;; *) _unknown_opt await \"$1\"; return $? ;; esac; done"},{"line_number":1356,"content":"  # first check asks for `timeout - 1`. `--timeout 600` then dispatched"},{"line_number":1357,"content":"  # `--timeout-ms 599000`, silently short-changing the caller's stated budget and"},{"line_number":1370,"content":"    args+=(--wait --types worker_done --timeout-ms \"$(( remaining * 1000 ))\" --json)"},{"line_number":1493,"content":"_cmd_gate_wait() {  # <gate_id> [--timeout <s>] [--interval <s>]"},{"line_number":1503,"content":"    --timeout) _need_val gate-wait --timeout $# || return $?; timeout=\"$2\"; shift 2 ;; --interval) _need_val gate-wait --interval $# || return $?; interval=\"$2\"; shift 2 ;;"},{"line_number":1527,"content":"  # `--out` is what a waiter polls for, so it must never be observable"},{"line_number":1534,"content":"  # mktemp, not \"$$\": a single wrapper invocation can write --out more than"},{"line_number":1546,"content":"_cmd_report_wait() {  # <report-path> [--timeout <s>] [--interval <s>]"},{"line_number":1558,"content":"  # `exec --out` case, copied into place once the agent has finished. Opt-in:"},{"line_number":1560,"content":"  # else, and it is sound here only because `exec` now writes `--out`"},{"line_number":1982,"content":"# THE FIX. agy grows `--output-format stream-json`, which emits one NDJSON event"},{"line_number":1992,"content":"# response text, `--out` is the response text, `$?` is still \"did the CLI run\"."},{"line_number":1999,"content":"# last-writer hazard J29 records for --out, arriving here by a different route."},{"line_number":2237,"content":"  # deterministically `STATUS: NEEDS_CONTEXT` -- and the caller wrote it to --out,"},{"line_number":2335,"content":"_cmd_ask() {  # <agent> <promptfile> [--timeout <s>] [--out <file>]"},{"line_number":2338,"content":"  # buffer. The orchestration path is `dispatch`+`await`; the report-file path is"},{"line_number":2351,"content":"    --timeout) _need_val ask --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"},{"line_number":2352,"content":"    --out) _need_val ask --out $# || return $?; out=\"$2\"; shift 2 ;;"},{"line_number":2361,"content":"  local wargs=(\"$agent\"); [ -n \"$timeout\" ] && wargs+=(--timeout \"$timeout\")"},{"line_number":2371,"content":"_cmd_probe() {  # <agent> [--timeout <s>]"},{"line_number":2384,"content":"    --timeout) _need_val probe --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"},{"line_number":2388,"content":"    ''|*[!0-9]*|0) echo \"hmad-dispatch: probe: --timeout must be a positive integer; nothing was sent.\" >&2; return 2 ;;"},{"line_number":2724,"content":"# Does a recovered agy response carry a verdict line worth promoting to --out?"},{"line_number":2745,"content":"# J29: `--out` is last-writer-wins across concurrent dispatches, silently. Two"},{"line_number":2747,"content":"# responder's answer, so a caller who reads `--out` loses a verdict with nothing"},{"line_number":2760,"content":"# Refuse to overwrite an `--out` whose content changed since this dispatch"},{"line_number":2766,"content":"# and SKILL.md's --out paths are templated per feature+module, so a legitimate"},{"line_number":2779,"content":"  echo \"hmad-dispatch: exec: REFUSING to overwrite --out $f — its content changed while this dispatch ran (another dispatch wrote there; J29). Existing file preserved; this dispatch's answer is on stdout and in the transcript.\" >&2"},{"line_number":2783,"content":"# Called as `write || _out_write_failed <file>` at every exec --out write site."},{"line_number":2785,"content":"# dispatch (rc=1, empty stdout), so an unwritable --out -- a typo'd directory --"},{"line_number":2789,"content":"  echo \"hmad-dispatch: exec: cannot write --out $1 (J56). This dispatch's answer is on stdout and in the transcript.\" >&2"},{"line_number":2944,"content":"  # --output-last-message file, and exactly one transcript line —"},{"line_number":2969,"content":"_cmd_exec() {  # <codex|agy|grok> <promptfile> [--cd <dir>] [--model <m>] [--effort <e>] [--out <file>] [--log <file>] [--timeout <s>] [codex: --sandbox <mode>] [agy: --sandbox] [grok: --sandbox <profile>]"},{"line_number":2978,"content":"  #   codex — `codex exec`, prompt via stdin, final message via --output-last-message."},{"line_number":3066,"content":"    --out) _need_val exec --out $# || return $?; out=\"$2\"; shift 2 ;;"},{"line_number":3068,"content":"    --timeout) _need_val exec --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"}]}]},"locations":[]}
