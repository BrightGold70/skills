#!/usr/bin/env python3
"""h_mad_audit_gate.py - classify H-MAD audit files for blocking findings."""
from __future__ import annotations

import argparse
import subprocess
import hashlib
import json
import os
import re
import sys
from pathlib import Path
from typing import NamedTuple
