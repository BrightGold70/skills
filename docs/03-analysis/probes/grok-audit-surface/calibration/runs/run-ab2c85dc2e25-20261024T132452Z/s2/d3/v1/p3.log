ble\"])"},{"line_number":2014,"content":"        head = \"ok\" if result[\"verdict\"] == \"ANCHORS_OK\" else \"DRIFTED\""},{"line_number":2023,"content":"        for entry in result[\"unreadable\"]:"},{"line_number":2024,"content":"            print(f\"  unreadable: {entry}\")"},{"line_number":2032,"content":"        # the drift and unreadable findings above it, which are the ones that"},{"line_number":2055,"content":"        \"ANCHORS_UNREADABLE\" if unreadable or unclassifiable"},{"line_number":2057,"content":"        else \"ANCHORS_OK\""},{"line_number":2061,"content":"        f\"ok={ok} drifted={drifted} unreadable={unreadable} \""},{"line_number":2079,"content":"    if unreadable:"},{"line_number":2093,"content":"    return 0 if verdict == \"ANCHORS_OK\" else 2"},{"line_number":2148,"content":"_MEASURED = (\"ALL_CAUGHT\", \"SURVIVED\")"},{"line_number":2200,"content":"    head = \"ALL_CAUGHT\" if counts[\"all_caught\"] == swept and swept else \"NOT_ALL_CAUGHT\""},{"line_number":2437,"content":"            f\"unreadable={len(result['unreadable'])}\""},{"line_number":2446,"content":"            # cause, and an unreadable target is the one whose next action differs"},{"line_number":2448,"content":"            f\"unreadable={sum(1 for e in result['refused'] if 'cannot read' in e)} \""},{"line_number":2470,"content":"            # suite go red?\" rather than \"did that test bite?\". `ALL_CAUGHT"},{"line_number":2511,"content":"    for entry in result.get(\"unreadable\", []):"},{"line_number":2512,"content":"        print(f\"  unreadable: {entry['spec']} root {entry['root']}: {entry['error']}\")"},{"line_number":2513,"content":"    # Caught mutations carry their killer too. `ALL_CAUGHT` is satisfied by a"},{"line_number":2557,"content":"    return 0 if verdict in {\"ALL_CAUGHT\", \"SURVIVED\"} else 2"}]}]},"locations":[]}
