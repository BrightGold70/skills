"content":"  # `exec --out` case, copied into place once the agent has finished. Opt-in:"},{"line_number":1560,"content":"  # else, and it is sound here only because `exec` now writes `--out`"},{"line_number":1972,"content":"#           `_cmd_exec` redirects that straight into $log. `--log` really was"},{"line_number":1976,"content":"#           $log. So agy's `--log` held zero bytes for the whole run and a"},{"line_number":1979,"content":"#           `agy --log-file` is not a substitute: it is language-server noise"},{"line_number":1982,"content":"# THE FIX. agy grows `--output-format stream-json`, which emits one NDJSON event"},{"line_number":1984,"content":"# 48s run). That stream goes append-direct into $log, so `--log` is now live for"},{"line_number":1992,"content":"# response text, `--out` is the response text, `$?` is still \"did the CLI run\"."},{"line_number":1997,"content":"# Scoped to lines AFTER $2 so a caller-supplied --log holding a PRIOR dispatch's"},{"line_number":1999,"content":"# last-writer hazard J29 records for --out, arriving here by a different route."},{"line_number":2052,"content":"# steps in a shared --log cannot be reported as this one's."},{"line_number":2237,"content":"  # deterministically `STATUS: NEEDS_CONTEXT` -- and the caller wrote it to --out,"},{"line_number":2251,"content":"  #     alone, or content a caller pre-loaded into --log. There is no echo to skip and"},{"line_number":2260,"content":"  # not a hypothetical one. Both arms append to a caller-supplied --log with `>>`,"},{"line_number":2335,"content":"_cmd_ask() {  # <agent> <promptfile> [--timeout <s>] [--out <file>]"},{"line_number":2351,"content":"    --timeout) _need_val ask --timeout $# || return $?; timeout=\"$2\"; shift 2 ;;"},{"line_number":2352,"content":"    --out) _need_val ask --out $# || return $?; out=\"$2\"; shift 2 ;;"},{"line_number":2361,"content":"  local wargs=(\"$agent\"); [ -n \"$timeout\" ] && wargs+=(--timeout \"$timeout\")"}]}]},"locations":[]}
