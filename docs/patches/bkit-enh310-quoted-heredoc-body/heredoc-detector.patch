 /**
+ * Excise the BODIES of quoted-tag heredocs (`<<'TAG'` / `<<"TAG"`), preserving
+ * the heredoc markers and the terminator line.
+ *
+ * Rationale (ENH-310 false-positive class):
+ *   bash performs NO expansion inside a quoted-tag heredoc body — that is a
+ *   language guarantee, not heuristic quote-parsing. Text sitting in such a body
+ *   can never become shell syntax, so a `$(cmd <<TAG …)` sequence appearing
+ *   there is inert prose (e.g. documentation about this very guard), not a
+ *   command substitution.
+ *
+ * Scope of the exemption — deliberately narrow:
+ *   ONLY the 'sub' vector consults the reduced text. 'pipe-shell',
+ *   'eval-source' and 'sudo' continue to scan the FULL command string, because
+ *   a quoted-tag body piped to a shell IS executed verbatim (see CR-22/CR-23)
+ *   even though it is never expanded. Unquoted `<<TAG` bodies are never excised
+ *   at all, since `$()` in those bodies does expand.
+ *
+ * Markers survive, so a genuine `$(cat <<'EOF' … EOF)` still matches critically:
+ * the `$(`, the `<<'EOF'` and the closing `)` are all outside the excised body.
+ *
+ * Pure function — no IO, consistent with design invariant #1.
+ *
+ * @param {string} text
+ * @returns {string}
+ */
+function stripQuotedHeredocBodies(text) {
+  const START = /<<-?[ \t]*(['"])(\w+)\1/;
+  let out = '';
+  let remaining = text;
+
+  for (;;) {
+    const m = remaining.match(START);
+    if (!m) break;
+
+    const tag = m[2];
+    const startEnd = m.index + m[0].length;
+    const nl = remaining.indexOf('\n', startEnd);
+    if (nl === -1) break; // single-line command — no body to excise
+
+    const after = remaining.slice(nl + 1);
+    const tm = after.match(new RegExp(`^[ \\t]*${tag}[ \\t]*$`, 'm'));
+    if (!tm) break; // unterminated heredoc — leave text untouched (fail safe)
+
+    out += remaining.slice(0, nl + 1) + '__BKIT_QUOTED_HEREDOC_BODY__\n';
+    remaining = after.slice(tm.index); // resume at the terminator line
+  }
+
+  return out + remaining;
+}
+
